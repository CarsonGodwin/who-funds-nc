# Optional: external CDN/bucket URL for the parquet files.
# Leave unset to serve them from the site itself (public/parquet).
# PUBLIC_DATA_URL=https://your-data-bucket.example.com

# Supabase party tagging is disabled in NC migration v1.
# Uncomment these only if you re-enable community tagging.
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
