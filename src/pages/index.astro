---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { APPROX_DOWNLOAD_LABEL } from '../lib/tables';

const TOOLS = [
  {
    path: 'search/committees',
    title: 'Committees',
    description: 'Browse every candidate committee ranked by money raised, then open a profile for top donors and fundraising over time.',
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
  },
  {
    path: 'search/contributors',
    title: 'Donors',
    description: 'Look up any contributor by name and see every itemized gift, with amounts, dates, and who received it.',
    icon: 'M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    path: 'advanced',
    title: 'List Builder',
    description: 'Filter contributions or expenditures by amount, date, location, employer and more, group by donor, and export to CSV.',
    icon: 'M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75',
  },
  {
    path: 'query-builder',
    title: 'Expert Mode',
    description: 'Combine conditions with AND/OR logic, group and aggregate any table, and see the SQL behind every result.',
    icon: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5',
  },
];

const READY_LISTS = [
  { label: 'Donors who gave $10,000+ in total', path: 'advanced?groupByDonor=true&minTotalAmount=10000' },
  { label: 'Repeat donors with 5 or more contributions', path: 'advanced?groupByDonor=true&minContributions=4' },
  { label: 'Single contributions of $5,000 or more', path: 'advanced?amountMin=5000' },
  { label: 'Contributions from businesses and organizations', path: 'advanced?contributorType=ENTITY' },
];

const STATS = [
  { key: 'contributions', label: 'Contributions' },
  { key: 'filers', label: 'Committees' },
  { key: 'expenditures', label: 'Expenditures' },
];
---

<BaseLayout title="Home">
  <section class="bg-nc-blue pb-20 text-white">
    <div class="page-container pt-10 sm:pt-16">
      <h1 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">Follow the money in North Carolina politics</h1>
      <p class="mt-4 max-w-2xl text-lg text-blue-100">
        Search itemized campaign contributions to North Carolina candidates and committees, straight from State Board of
        Elections filings.
      </p>

      <form role="search" method="get" action={withBase('search/contributors')} class="mt-8 max-w-3xl">
        <label for="home-search" class="sr-only">Donor or committee name</label>
        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="relative flex-1">
            <svg class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              id="home-search"
              name="q"
              type="search"
              required
              autocomplete="off"
              placeholder="Donor or committee name"
              class="input-lg border-transparent pl-12 shadow-lg"
            />
            <kbd class="pointer-events-none absolute top-1/2 right-3 hidden -translate-y-1/2 rounded border border-slate-200 px-1.5 text-xs text-slate-400 sm:block" aria-hidden="true">/</kbd>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="btn flex-1 bg-white px-5 py-3 text-nc-blue shadow-lg hover:bg-blue-50">Search donors</button>
            <button type="submit" formaction={withBase('search/committees')} class="btn flex-1 border border-white/30 px-5 py-3 text-white hover:bg-white/10">
              Search committees
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <div class="page-container">
    <!-- Dataset size, overlapping the hero -->
    <section aria-label="Dataset size" class="card -mt-10 grid grid-cols-2 divide-slate-200 sm:grid-cols-4 sm:divide-x">
      {STATS.map((stat) => (
        <div class="p-5">
          <p class="stat-label">{stat.label}</p>
          <p class="stat-value" data-stat={stat.key}>—</p>
        </div>
      ))}
      <div class="p-5">
        <p class="stat-label">Coverage</p>
        <p class="stat-value">2020 – March 2026</p>
      </div>
    </section>

    <section class="mt-14" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="text-xl font-semibold tracking-tight text-slate-900">Explore the data</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {TOOLS.map((tool) => (
          <a href={withBase(tool.path)} class="card group flex gap-4 p-5 transition hover:border-nc-blue/40 hover:shadow-md">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-nc-blue-light text-nc-blue" aria-hidden="true">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d={tool.icon}></path>
              </svg>
            </span>
            <span>
              <span class="flex items-center gap-1.5 font-semibold text-slate-900 group-hover:text-nc-blue">
                {tool.title}
                <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </span>
              <span class="mt-1 block text-sm text-slate-600">{tool.description}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14 grid gap-6 lg:grid-cols-3">
      <div class="card lg:col-span-2">
        <div class="card-header">
          <h2 class="card-title">Ready-made lists</h2>
          <a href={withBase('advanced')} class="link text-sm">Build your own</a>
        </div>
        <ul class="divide-y divide-slate-100">
          {READY_LISTS.map((list) => (
            <li>
              <a href={withBase(list.path)} class="flex items-center justify-between gap-4 px-5 py-3.5 text-sm text-slate-700 transition-colors hover:bg-slate-50 hover:text-nc-blue">
                {list.label}
                <span aria-hidden="true" class="text-slate-400">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="card p-5">
        <h2 class="card-title">How this works</h2>
        <ul class="mt-3 space-y-3 text-sm text-slate-600">
          <li>
            The first search downloads the full dataset ({APPROX_DOWNLOAD_LABEL}) into your browser. After that it loads
            from your cache.
          </li>
          <li>Every query runs locally on your device, so nothing you search for is sent to a server.</li>
          <li>
            Records come from
            <a href="https://www.ncsbe.gov/campaign-finance" target="_blank" rel="noopener noreferrer" class="link">NCSBE campaign finance reports</a>
            and include itemized contributions from 2020 onward.
          </li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { dataUrl } from '../lib/data-url';

  // "/" jumps to the search box, unless the user is already typing somewhere.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement;
    if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
    e.preventDefault();
    document.getElementById('home-search')?.focus();
  });

  // Row counts are written next to the parquet files by the conversion script.
  fetch(dataUrl('stats.json'))
    .then((res) => (res.ok ? res.json() : Promise.reject(new Error(`HTTP ${res.status}`))))
    .then((stats: Record<string, number>) => {
      document.querySelectorAll<HTMLElement>('[data-stat]').forEach((el) => {
        const value = stats[el.dataset.stat!];
        if (typeof value === 'number') el.textContent = value.toLocaleString();
      });
    })
    .catch((err) => console.warn('Could not load stats.json:', err));
</script>
