---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AdvancedSearch from '../components/AdvancedSearch';
import { withBase } from '../lib/url';
---

<BaseLayout title="List Builder" description="Build filtered lists of North Carolina campaign contributions and expenditures">
  <div class="page-container py-8">
    <PageHeader
      title="List Builder"
      description="Filter contributions or expenditures by amount, date, location, employer and more. Export any list to CSV."
    >
      <a slot="actions" href={withBase('query-builder')} class="btn-secondary self-start sm:self-auto">
        Need AND/OR logic? Try Expert Mode →
      </a>
    </PageHeader>
    <AdvancedSearch client:load />
  </div>
</BaseLayout>
