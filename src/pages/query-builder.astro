---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QueryBuilderComponent from '../components/QueryBuilder';
---

<BaseLayout title="Expert Mode" description="Query North Carolina campaign finance data with boolean logic and aggregations">
  <div class="page-container py-8">
    <PageHeader
      title="Expert Mode"
      description="Combine conditions with AND/OR groups, aggregate with GROUP BY, and see the SQL that runs."
    />
    <QueryBuilderComponent client:load />
  </div>
</BaseLayout>
