---
import BaseLayout from '../layouts/BaseLayout.astro';
import CandidateProfile from '../components/CandidateProfile';
import { withBase } from '../lib/url';
---

<BaseLayout title="Committee Profile" description="Contributions, top donors, and fundraising over time for a North Carolina committee">
  <div class="page-container py-8">
    <!-- The committee's name is only known client-side, so the profile renders its own heading. -->
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={withBase('/')} class="hover:text-nc-blue">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={withBase('search/committees')} class="hover:text-nc-blue">Committees</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-slate-700">Profile</li>
      </ol>
    </nav>
    <CandidateProfile client:load />
  </div>
</BaseLayout>
